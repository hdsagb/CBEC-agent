# ===== 应用 =====
APP_NAME=CBEC Agent

# ===== 数据库（本地开发默认 SQLite 可留空；生产用 PostgreSQL）=====
DATABASE_URL=
POSTGRES_PASSWORD=cbec123

# ===== 认证 =====
# JWT 签名密钥：必填。服务启动时会做安全自检，空值、下方示例值或短于 16 位的密钥将拒绝启动。
# 生成一条即可（示例值本身已公开，不能用于任何真实环境）：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ===== LLM =====
# 全局一套模型配置：优先使用页面（对话页右上角模型标识）保存到数据库的配置，
# 以下环境变量仅作为首次启动 / 尚未在页面保存时的兜底。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库中 API Key 的加密密钥：必填（至少 16 位随机串），否则页面无法保存 Key。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 更换该密钥会导致已保存的 Key 无法解密，需要在页面上重新保存一次。
LLM_CONFIG_SECRET=

# 允许访问的模型接口地址白名单（JSON 数组）。留空表示允许任意公网 HTTPS 地址，
# 但始终拒绝环回地址、内网 IP 与带账号密码的 URL（防 SSRF）。
# 自建内网模型（如 Ollama / vLLM）需在此显式放行，例如：
# LLM_ALLOWED_BASE_URLS=["http://192.168.1.20:11434"]
LLM_ALLOWED_BASE_URLS=[]

# 多模态（图片报价单识别）：配置支持视觉的模型后优先走 LLM，留空则回退本地 OCR
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# 本地 OCR 兜底（图片报价单识别，依赖 rapidocr + onnxruntime）
OCR_ENABLED=true

# ===== 上传 =====
UPLOAD_DIR=./uploads

# 箱唛导出使用的中文 TrueType 字体路径；留空则自动探测系统字体（详见 README）
MARK_FONT_FILE=
