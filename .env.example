# ===== 应用 =====
APP_NAME=CBEC Agent

# ===== 数据库（本地开发默认 SQLite 可留空；生产用 PostgreSQL）=====
DATABASE_URL=
POSTGRES_PASSWORD=cbec123

# ===== 认证 =====
JWT_SECRET=change-me-to-a-random-long-string

# ===== LLM =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 多模态（图片报价单识别）：配置支持视觉的模型后优先走 LLM，留空则回退本地 OCR
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# 本地 OCR 兜底（图片报价单识别，依赖 rapidocr + onnxruntime）
OCR_ENABLED=true

# ===== 上传 =====
UPLOAD_DIR=./uploads
